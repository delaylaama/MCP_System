# ==============================================================================
# Universal AI File Manager - Environment Variables Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=supersecretjwtkey_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256 / Fernet key for encrypting OAuth tokens in Database (generate with cryptography.fernet.Fernet.generate_key().decode())
ENCRYPTION_KEY=5T4z4W8_u92pUaTfFv9t0tq2L1xXy4hZkR7Y9o8U1e0=

# Database Configuration (PostgreSQL in production/docker; SQLite async supported for local dev)
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_file_manager
# SQLite fallback: sqlite+aiosqlite:///./mcp_file_manager.db
DATABASE_URL=sqlite+aiosqlite:///./mcp_file_manager.db

# Frontend and CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MCP Server Configuration
# Use Streamable HTTP endpoint for official MCP Python SDK v2
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Local Storage Directory
LOCAL_STORAGE_ROOT=./local_storage

# AI & LLM Service (Supports OpenAI or Gemini or local mock provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database / Embeddings
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Google Drive OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/providers/google_drive/callback

# Microsoft OneDrive / Graph OAuth 2.0 Credentials
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/providers/onedrive/callback

# Dropbox OAuth 2.0 Credentials
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI=http://localhost:8000/api/providers/dropbox/callback
